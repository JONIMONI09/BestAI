<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31) Datenextraktionsregeln.
     Die App haelt nur das gepackte Demo-Modell; Sicherung und
     Geraete-Transfer werden bewusst deaktiviert, damit keine lokalen
     Modell-/Statusdaten den Geraet verlassen. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>