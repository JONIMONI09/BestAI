<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.DarkActionBar"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">
        <!-- Kein android:screenOrientation: eine fixe Orientierung erzeugt
             Letterboxing auf Chromebooks/Tablets (Android-Lint
             LockedOrientationActivity/DiscouragedApi). Die UI ist vertikal
             aufgebaut und funktioniert in beiden Orientierungen. -->
        <!-- Started by MainActivity on the next launch when a crash report
             file exists. It is deliberately NOT started from the
             UncaughtExceptionHandler any more: the handler only writes the
             report and delegates to the platform, because a dying process
             cannot be relied on to bring up an Activity. Not exported and
             not in the recents - it is not user-facing navigation. -->
        <activity
            android:name=".CrashActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>