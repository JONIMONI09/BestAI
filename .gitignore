# Build artifacts
hydra-run
hydra-test
hydra-run-*
hydra-test-*
jni-batch-test
large-model-test
gpu_bench_cpu
*.o
node_modules/
# package-lock.json wird bewusst MIT committed: `npm ci` in der CI
# braucht ihn fuer reproduzierbare Linter-Versionen.

# Models
*.hydra
# GGUF weights are third-party model weights under their own licence, not
# source. tools/fetch_test_model.sh downloads them on demand; committing one
# would add ~100 MB per model to the history permanently.
*.gguf
models/
# Uploaded models are user data, never committed.
models/uploaded/
# The one exception: the starter model is packaged into the APK, so it has to
# be in git. Without this rule the rename demo.hydra -> starter.hydra silently
# dropped it from the tree, and CI failed with "starter.hydra differs from
# tools/make_model.py output" - a fresh checkout had no file to compare to.
!android/app/src/main/assets/starter.hydra

# Release staging (produced by .github/workflows/release.yml)
dist/

# Python
__pycache__/
*.pyc

# Archives
*.zip

# Editor
.vscode/
.idea/

# Local agent workspace (session research, mirrors of external notes).
# Deliberately never committed: it is working memory, not a deliverable, and
# a mirror of a Notion page in git would drift from the original.
.agent_memory/
RESEARCH.md
# Console artefacts (generated models, vocabularies)
models/trained/
models/vocab/

# Local working aids (never committed: they are aids, not gates;
# tools/docs_claim_check.sh remains the committed CI-side audit).
tools/local_scan.py
